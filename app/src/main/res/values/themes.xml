<!-- File: app/src/main/res/values/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Основная светлая тема -->
    <style name="Theme.Androiddd" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основной акцентный цвет -->
        <item name="colorPrimary">#1565C0</item> <!-- Темно-синий -->
        <!-- Вторичный акцентный цвет -->
        <item name="colorSecondary">#4CAF50</item> <!-- Зеленый -->

        <!-- Цвета для "поверхностей" (фоны карточек, EditText и т.д.) -->
        <item name="colorSurface">#FFFFFF</item> <!-- Белый фон -->
        <item name="colorOnSurface">#333333</item> <!-- Темный текст на светлом фоне -->

        <!-- Цвета для элементов управления (EditText, Switch и т.д.) -->
        <item name="colorControlNormal">#666666</item> <!-- Цвет иконок и подчеркивания в неактивном состоянии -->
        <item name="colorControlActivated">#1565C0</item> <!-- Цвет активного элемента (фокус, выделение) -->
        <item name="colorControlHighlight">#441565C0</item> <!-- Цвет эффекта ripple -->

        <!-- Цвета для первичного и вторичного текста -->
        <item name="android:textColorPrimary">#333333</item> <!-- Основной текст -->
        <item name="android:textColorSecondary">#666666</item> <!-- Вторичный текст -->

        <!-- Цвет фона строки состояния -->
        <item name="android:statusBarColor">#1565C0</item>
        <!-- Цвет иконок в строке состояния (true - темные, false - светлые) -->
        <item name="android:windowLightStatusBar">true</item> <!-- Иконки темные на светлом фоне -->
        <!-- Цвет фона окна -->
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Тема для SplashScreen -->
    <style name="Theme.Androiddd.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1565C0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Androiddd</item>
    </style>
</resources>