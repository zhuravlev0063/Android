<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:padding="@dimen/lesson_detail_input_margin_bottom"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/dayIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_calendar"
        android:layout_marginEnd="@dimen/lesson_detail_color_button_margin"
        android:contentDescription="Календарь дня" />

    <TextView
        android:id="@+id/dayNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/text_size_large"
        android:textColor="@color/colorOnSurface" />

</LinearLayout>