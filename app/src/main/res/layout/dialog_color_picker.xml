<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/lesson_detail_save_button_margin"
    android:background="@drawable/dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lesson_detail_8dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_title_color_picker"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:gravity="center"
            android:layout_marginBottom="@dimen/lesson_detail_save_button_margin" />

        <!-- Палитра цветов -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_color_palette"
            android:textSize="@dimen/text_size_medium"
            android:textColor="@color/colorOnSurfaceVariant"
            android:layout_marginBottom="@dimen/lesson_detail_8dp" />

        <!-- ★★★ Matrix в центре ★★★ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lesson_detail_save_button_margin"
            android:padding="@dimen/lesson_item_margin_bottom"
            android:background="@color/colorSurfaceVariant"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <GridLayout
                    android:id="@+id/colorGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="13"
                    android:rowCount="13"
                    android:padding="@dimen/lesson_detail_color_button_size" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/lesson_detail_color_button_size_1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="@dimen/lesson_detail_save_button_margin" />

        <!-- Ручной ввод -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_manual_input"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:layout_marginBottom="@dimen/lesson_detail_input_margin_bottom" />

        <!-- HEX ввод -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/lesson_detail_input_margin_bottom">

            <TextView
                android:layout_width="@dimen/dialog_rgb_input_width"
                android:layout_height="wrap_content"
                android:text="@string/label_hex_code"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/hexInput"
                android:layout_width="@dimen/lesson_detail_0dp"
                android:layout_height="@dimen/dialog_rgb_input_height"
                android:layout_weight="1"
                android:text="@string/default_color_hex"
                android:textSize="@dimen/text_size_medium"
                android:background="@drawable/edit_text_rounded"
                android:paddingStart="@dimen/lesson_detail_input_margin_bottom"
                android:paddingEnd="@dimen/lesson_detail_input_margin_bottom"
                android:inputType="textCapCharacters"
                android:maxLines="1" />

        </LinearLayout>

        <!-- RGB ввод -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/lesson_detail_save_button_margin">

            <TextView
                android:layout_width="@dimen/dialog_rgb_input_width"
                android:layout_height="wrap_content"
                android:text="@string/label_rgb"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="@dimen/lesson_detail_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <EditText
                    android:id="@+id/redInput"
                    android:layout_width="@dimen/lesson_detail_0dp"
                    android:layout_height="@dimen/dialog_rgb_input_height"
                    android:layout_weight="1"
                    android:text="@string/default_color_red"
                    android:textSize="@dimen/text_size_medium"
                    android:background="@drawable/edit_text_rounded"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/lesson_item_margin_bottom" />

                <EditText
                    android:id="@+id/greenInput"
                    android:layout_width="@dimen/lesson_detail_0dp"
                    android:layout_height="@dimen/dialog_rgb_input_height"
                    android:layout_weight="1"
                    android:text="@string/default_color_green"
                    android:textSize="@dimen/text_size_medium"
                    android:background="@drawable/edit_text_rounded"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/lesson_item_margin_bottom" />

                <EditText
                    android:id="@+id/blueInput"
                    android:layout_width="@dimen/lesson_detail_0dp"
                    android:layout_height="@dimen/dialog_rgb_input_height"
                    android:layout_weight="1"
                    android:text="@string/default_color_blue"
                    android:textSize="@dimen/text_size_medium"
                    android:background="@drawable/edit_text_rounded"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLines="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Превью и кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/dialog_rgb_input_width"
                android:layout_height="wrap_content"
                android:text="@string/label_preview"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/colorOnSurfaceVariant" />

            <View
                android:id="@+id/colorPreview"
                android:layout_width="@dimen/lesson_detail_spinner_height"
                android:layout_height="@dimen/lesson_detail_spinner_height"
                android:background="@color/colorPrimary"
                android:layout_marginEnd="@dimen/lesson_detail_save_button_margin"
                android:elevation="@dimen/lesson_item_margin_bottom" />

            <!-- Кнопка Готово -->
            <Button
                android:id="@+id/doneButton"
                android:layout_width="@dimen/lesson_detail_0dp"
                android:layout_height="@dimen/dialog_color_preview_size_44"
                android:layout_weight="1"
                android:text="@string/dialog_button_done"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                android:textColor="@color/colorOnPrimary"
                android:background="@drawable/button_rounded"
                android:layout_marginEnd="@dimen/lesson_detail_8dp" />

            <!-- Кнопка Отмена -->
            <Button
                android:id="@+id/cancelButton"
                android:layout_width="@dimen/lesson_detail_0dp"
                android:layout_height="@dimen/dialog_color_preview_size_44"
                android:layout_weight="1"
                android:text="@string/dialog_button_cancel"
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/colorOnPrimary"
                android:background="@drawable/button_cancel"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>