<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androiddd">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Androiddd"> <!-- Тема приложения по умолчанию -->

        <!-- LoginActivity теперь является точкой входа (LAUNCHER) и использует SplashScreen -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Androiddd.SplashScreen"> <!-- Применяем тему SplashScreen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Androiddd" /> <!-- Убедитесь, что другие активности тоже используют совместимую тему -->

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Androiddd" /> <!-- Убедитесь, что другие активности тоже используют совместимую тему -->

        <!-- LessonDetailActivity -->
        <activity
            android:name=".LessonDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Androiddd" /> <!-- Убедитесь, что другие активности тоже используют совместимую тему -->

    </application>

</manifest>